doctype html
html(lang='ko')
	head
		meta(charset='utf-8')
		meta(name='viewport', content='width=device-width, initial-scale=1')
		title 끄투 로그인
		link(rel='stylesheet', href='/css/local-auth.css?v=1')
	body
		main.auth-shell
			section.auth-card
				div.auth-brand
					span.auth-kicker 글자로 놀자!
					h1 KKUTU
					p 로그인하거나 비회원으로 바로 시작하세요.
				if error
					div.auth-message.error= error
				if notice
					div.auth-message= notice
				div.auth-tabs
					button.auth-tab.active(type='button', data-target='login-form') 로그인
					button.auth-tab(type='button', data-target='register-form') 회원가입
				form#login-form.auth-form(method='post', action='/auth/login')
					label(for='login-id') 아이디
					input#login-id(name='id', autocomplete='username', minlength='3', maxlength='20', required, autofocus)
					label(for='login-password') 비밀번호
					input#login-password(type='password', name='password', autocomplete='current-password', minlength='4', maxlength='64', required)
					button.auth-primary(type='submit') 로그인하고 시작
				form#register-form.auth-form.hidden(method='post', action='/auth/register')
					label(for='register-id') 아이디
					input#register-id(name='id', autocomplete='username', pattern='[A-Za-z0-9_]{3,20}', minlength='3', maxlength='20', required)
					small 영문, 숫자, 밑줄 3~20자
					label(for='register-password') 비밀번호
					input#register-password(type='password', name='password', autocomplete='new-password', minlength='4', maxlength='64', required)
					label(for='register-password-check') 비밀번호 확인
					input#register-password-check(type='password', name='passwordCheck', autocomplete='new-password', minlength='4', maxlength='64', required)
					button.auth-primary(type='submit') 회원가입하고 시작
				a.auth-guest(href='/guest') 비회원으로 시작
				p.auth-foot 비회원 기록은 저장되지 않습니다.
		script.
			(function () {
				var tabs = document.querySelectorAll('.auth-tab');
				for (var i = 0; i < tabs.length; i++) tabs[i].onclick = function () {
					for (var j = 0; j < tabs.length; j++) tabs[j].classList.remove('active');
					this.classList.add('active');
					document.getElementById('login-form').classList.toggle('hidden', this.dataset.target !== 'login-form');
					document.getElementById('register-form').classList.toggle('hidden', this.dataset.target !== 'register-form');
				};
			})();
